---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import TOC from "@components/widget/TOC.astro";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
>
	<slot slot="head" name="head" />
	<div class="rose-ambient" aria-hidden="true"></div>
	<div id="top-row">
		<div id="navbar-wrapper"><Navbar /></div>
	</div>
	<div id="main-grid" class="rose-shell">
		<main id="swup-container" class="transition-swup-fade" tabindex="-1">
			<div id="content-wrapper">
				<slot />
			</div>
		</main>
		<aside id="toc-wrapper" aria-label={i18n(Key.tableOfContents)}>
			<div id="toc-inner-wrapper" class="hide-scrollbar">
				{/* Swup 在每个页面都需要 #toc，包括未启用目录的页面。 */}
				<div id="toc" class="transition-swup-fade">
					{siteConfig.toc.enable && headings.length > 0 && (
						<details class="rose-toc-details" open>
							<summary>{i18n(Key.tableOfContents)}</summary>
							<TOC headings={headings} />
						</details>
					)}
				</div>
			</div>
		</aside>
	</div>
	<Footer />
	<BackToTop />
</Layout>

<script>
	const desktop = matchMedia("(min-width: 1280px)");
	const syncToc = () => {
		const details = document.querySelector<HTMLDetailsElement>(".rose-toc-details");
		if (details) details.open = desktop.matches;
	};
	syncToc();
	desktop.addEventListener("change", syncToc);
	document.addEventListener("swup:content:replace", syncToc);
</script>
