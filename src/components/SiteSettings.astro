---
import { Icon } from "astro-icon/components";
import AppearanceSettings from "./AppearanceSettings.astro";
import CursorSettings from "./CursorSettings.astro";
---
<details id="site-settings" class="relative" data-pagefind-ignore>
	<summary
		aria-label="设置"
		title="设置"
		class="btn-plain rounded-lg w-11 h-11 cursor-pointer list-none"
	>
		<Icon name="material-symbols:settings-outline-rounded" class="text-xl" />
	</summary>
	<div class="settings-menu rounded-2xl border border-[var(--line-color)] shadow-xl p-3">
		<AppearanceSettings />
		<CursorSettings />
	</div>
</details>
<script>
	import "@/scripts/settings-menu";
</script>
<style is:global>
	#site-settings > summary::-webkit-details-marker {
		display: none;
	}

	.settings-menu {
		position: absolute;
		right: 0;
		top: calc(100% + 1rem);
		width: 320px;
		max-width: calc(100vw - 2rem);
		max-height: calc(100dvh - 7rem);
		overflow: auto;
		background: var(--float-panel-bg);
	}

	.settings-submenu {
		max-height: calc(100dvh - 9rem);
		overflow: auto;
	}

	@media (min-width: 768px) {
		.settings-menu {
			width: 220px;
			overflow: visible;
		}

		.settings-menu > details {
			position: relative;
		}

		.settings-submenu {
			max-height: calc(100dvh - 12rem);
			position: absolute;
			right: calc(100% + 1rem);
			top: 0;
			width: 320px;
			border: 1px solid var(--line-color);
			border-radius: 1rem;
			background: var(--float-panel-bg);
			box-shadow: 0 12px 32px #0004;
			--disclosure-x: 10px;
			--disclosure-y: 0px;
		}
	}

	#site-settings :focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 3px;
	}
</style>
