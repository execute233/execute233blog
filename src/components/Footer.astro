---
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { LinkPresets } from "@constants/link-presets";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "@/config";

const currentYear = new Date().getFullYear();
const links = navBarConfig.links.map((link) =>
	typeof link === "number" ? LinkPresets[link] : link,
);
const title = siteConfig.title.split("|")[0].trim();
---

<footer class="rose-footer" data-pagefind-ignore>
	<div class="rose-footer-content">
		<div class="rose-footer-about">
			<a href={url("/")} class="rose-footer-brand">
				<ImageWrapper
					src={profileConfig.avatar || ""}
					alt=""
					class="w-14 h-14 rounded-2xl shrink-0"
				/>
				<span><strong>{title}</strong><span>{profileConfig.name}</span></span>
			</a>
			<p>{profileConfig.bio}</p>
			<span class="rose-footer-motto">HELLO WORLD 之后，还有很多世界。</span>
		</div>
		<nav class="rose-footer-navigation" aria-label={i18n(Key.navigation)}>
			<h2>{i18n(Key.navigation)}</h2>
			<ul>
				{links.map((link) => (
					<li>
						<a
							href={link.external ? link.url : url(link.url)}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noopener noreferrer" : undefined}
						>
							{link.name}
						</a>
					</li>
				))}
				<li><a href={url("/archive/")}>{i18n(Key.archive)}</a></li>
			</ul>
		</nav>
		<section class="rose-footer-contact" aria-label={i18n(Key.contact)}>
			<h2>{i18n(Key.contact)}</h2>
			<div>
				{profileConfig.links.map((link) => (
					<a href={link.url} target="_blank" rel="noopener noreferrer">
						<Icon name={link.icon} />
						<span>{link.name}</span>
						<span aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</section>
	</div>
	<div class="rose-footer-bottom">
		<p>© <span id="copyright-year">{currentYear}</span> {profileConfig.name}</p>
		<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
			粤ICP备2026124118号
		</a>
		<div>
			<a href={url("/rss.xml")} target="_blank" rel="noopener">RSS ↗</a>
			<a href={url("/sitemap-index.xml")} target="_blank" rel="noopener">Sitemap ↗</a>
		</div>
	</div>
</footer>
