---
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import "@/styles/rose-profile.css";
---

<div class="profile-interest-grid">
	{profileConfig.interests.map((interest) => (
		<article class="profile-interest-card surface">
			<div class="profile-interest-heading">
				<span class="eyebrow">{interest.label}</span>
				<Icon name={interest.icon} aria-hidden="true" />
			</div>
			<h3>{interest.title}</h3>
			<p>{interest.description}</p>
			<ul class="profile-tags" aria-label={`${interest.title}的方向`}>
				{interest.tags.map((tag) => <li>{tag}</li>)}
			</ul>
		</article>
	))}
</div>
