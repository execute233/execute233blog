---
import { url } from "@utils/url-utils";

const fonts = [
	{ file: "Regular", weight: 400, style: "normal" },
	{ file: "Italic", weight: 400, style: "italic" },
	{ file: "Medium", weight: 500, style: "normal" },
	{ file: "Medium-Italic", weight: 500, style: "italic" },
	{ file: "Bold", weight: 700, style: "normal" },
	{ file: "Bold-Italic", weight: 700, style: "italic" },
	{ file: "ExtraBold", weight: 800, style: "normal" },
	{ file: "ExtraBold-Italic", weight: 800, style: "italic" },
] as const;

const fontFaces = fonts
	.map(({ file, weight, style }) => {
		const fontUrl = url(`/fonts/jetbrains-mono/JetBrainsMono-${file}.woff2`);
		return `@font-face {
	font-family: "JetBrains Mono";
	src: url("${fontUrl}") format("woff2");
	font-weight: ${weight};
	font-style: ${style};
	font-display: swap;
}`;
	})
	.join("\n");
---

<link
	rel="preload"
	href={url("/fonts/jetbrains-mono/JetBrainsMono-Regular.woff2")}
	as="font"
	type="font/woff2"
	crossorigin="anonymous"
/>
<style is:inline set:html={fontFaces}></style>
