---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { PostForList } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

interface Props {
	sortedPosts?: PostForList[];
}
const { sortedPosts = [] } = Astro.props;
const groups = new Map<number, PostForList[]>();
for (const post of sortedPosts) {
	const year = post.data.published.getFullYear();
	const posts = groups.get(year) ?? [];
	posts.push(post);
	groups.set(year, posts);
}
const sortedGroups = [...groups].sort(([a], [b]) => b - a);
const formatDate = (date: Date) =>
	`${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
---

<archive-panel
	class="block"
	data-count-singular={i18n(I18nKey.postCount)}
	data-count-plural={i18n(I18nKey.postsCount)}
>
	<div class="card-base px-8 py-6">
		{sortedGroups.map(([year, posts]) => (
			<div>
				<div class="flex flex-row w-full items-center h-[3.75rem]">
					<div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75" data-year>
						{year}
					</div>
					<div class="w-[15%] md:w-[10%]">
						<div
							class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto
								-outline-offset-[2px] z-50 outline-3"
						/>
					</div>
					<div class="w-[70%] md:w-[80%] transition text-left text-50" data-count>
						{posts.length} {i18n(posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
					</div>
				</div>

				{posts.map((post) => (
					<a
						href={getPostUrlBySlug(post.slug)}
						aria-label={post.data.title}
						data-published={post.data.published.toISOString()}
						data-tags={JSON.stringify(post.data.tags)}
						data-category={post.data.category ?? ""}
						class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
					>
						<div class="flex flex-row justify-start items-center h-full">
							<div class="w-[15%] md:w-[10%] transition text-sm text-right text-50" data-date>
								{formatDate(post.data.published)}
							</div>
							<div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
								<div
									class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
										bg-[oklch(0.5_0_var(--hue))] group-hover:bg-[var(--primary)]
										outline outline-4 z-50 outline-[var(--card-bg)]
										group-hover:outline-[var(--btn-plain-bg-hover)]
										group-active:outline-[var(--btn-plain-bg-active)]"
								/>
							</div>
							<div
								class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
									group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
									text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
							>
								{post.data.title}
							</div>
							<div
								class="hidden md:block md:w-[15%] text-left text-sm transition
									whitespace-nowrap overflow-ellipsis overflow-hidden text-30"
							>
								{post.data.tags.map((tag) => `#${tag}`).join(" ")}
							</div>
						</div>
					</a>
				))}
			</div>
		))}
	</div>
</archive-panel>

<script>
	class ArchivePanel extends HTMLElement {
		private posts: {
			link: HTMLAnchorElement;
			date: Date;
			tags: string[];
			category: string;
		}[] = [];
		private header?: HTMLElement;
		private container!: HTMLElement;

		connectedCallback() {
			if (!this.container) {
				this.container = this.querySelector<HTMLElement>(".card-base")!;
				this.header =
					this.container.firstElementChild?.firstElementChild?.cloneNode(true) as
						| HTMLElement
						| undefined;
				this.posts = [...this.querySelectorAll<HTMLAnchorElement>("a")].map(
					(link) => ({
						link,
						date: new Date(link.dataset.published!),
						tags: JSON.parse(link.dataset.tags!),
						category: link.dataset.category!,
					}),
				);
			}
			this.filterPosts();
			window.addEventListener("popstate", this.filterPosts);
			this.dataset.ready = "true";
		}

		private filterPosts = () => {
			const params = new URLSearchParams(location.search);
			const tags = params.getAll("tag");
			const categories = params.getAll("category");
			const groups = new Map<number, HTMLAnchorElement[]>();
			for (const { link, date, tags: postTags, category } of this.posts) {
				if (tags.length && !postTags.some((tag) => tags.includes(tag))) continue;
				if (categories.length && (!category || !categories.includes(category)))
					continue;
				if (params.get("uncategorized") && category) continue;
				link.querySelector<HTMLElement>("[data-date]")!.textContent =
					`${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
				const year = date.getFullYear();
				const posts = groups.get(year) ?? [];
				posts.push(link);
				groups.set(year, posts);
			}
			const fragment = document.createDocumentFragment();
			for (const [year, posts] of [...groups].sort(([a], [b]) => b - a)) {
				const group = document.createElement("div");
				const header = this.header!.cloneNode(true) as HTMLElement;
				header.querySelector<HTMLElement>("[data-year]")!.textContent =
					String(year);
				header.querySelector<HTMLElement>("[data-count]")!.textContent =
					`${posts.length} ${posts.length === 1 ? this.dataset.countSingular : this.dataset.countPlural}`;
				group.append(header, ...posts);
				fragment.append(group);
			}
			this.container.replaceChildren(fragment);
		};

		disconnectedCallback() {
			window.removeEventListener("popstate", this.filterPosts);
		}
	}

	if (!customElements.get("archive-panel")) {
		customElements.define("archive-panel", ArchivePanel);
	}
</script>
