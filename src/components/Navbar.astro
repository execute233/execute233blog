---
import { LinkPresets } from "@constants/link-presets";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { pathsEqual, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "@/config";
import BackgroundSettings from "./BackgroundSettings.astro";
import Search from "./Search.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const logoTitle = "execute233";
const favicons = siteConfig.favicon.filter(
	(favicon) => favicon.sizes === "any",
);
const fallbackIcon = favicons[0]?.src ?? siteConfig.favicon[0].src;
const iconUrl = (src: string) => (src.startsWith("/") ? url(src) : src);
const icons: Record<string, string> = {
	"/": "material-symbols:home-outline-rounded",
	"/blog/": "material-symbols:article-outline-rounded",
	"/learning/": "material-symbols:menu-book-outline-rounded",
	"/tools/": "material-symbols:tune-rounded",
	"/about/": "material-symbols:person-outline-rounded",
};
const links = navBarConfig.links.map((link) =>
	typeof link === "number" ? LinkPresets[link] : link,
);
---

<a class="rose-skip-link" href="#swup-container">{i18n(Key.skipToContent)}</a>
<header id="navbar" class="rose-header" data-pagefind-ignore>
	<a
		href={url("/")}
		aria-label={`${logoTitle}，回到首页`}
		draggable="false"
		class="site-logo"
	>
		<picture class="logo-icon">
			{favicons.map((favicon) => (
				<source
					srcset={iconUrl(favicon.src)}
					media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
				/>
			))}
			<img src={iconUrl(fallbackIcon)} width="28" height="28" alt="" draggable="false" />
		</picture>
		<span class="logo-title" aria-hidden="true">{logoTitle}</span>
	</a>
	<div class="rose-header-actions">
		<div class="navbar-search"><Search client:load /></div>
		<BackgroundSettings />
		<button
			type="button"
			id="nav-menu-switch"
			class="rose-menu-trigger"
			aria-label={i18n(Key.menu)}
			aria-controls="nav-menu-panel"
			aria-expanded="false"
		>
			<Icon name="material-symbols:menu-rounded" />
		</button>
	</div>
	<nav class="rose-rail" aria-label={i18n(Key.navigation)}>
		{links.map((link) => (
			<a
				href={link.external ? link.url : url(link.url)}
				aria-label={link.name}
				aria-current={pathsEqual(Astro.url.pathname, url(link.url)) ? "page" : undefined}
				data-nav-path={!link.external ? url(link.url) : undefined}
				target={link.external ? "_blank" : undefined}
				rel={link.external ? "noopener noreferrer" : undefined}
			>
				<Icon name={icons[link.url] ?? "material-symbols:link-rounded"} />
				<span class="rose-rail-label" aria-hidden="true">{link.name}</span>
			</a>
		))}
	</nav>
	<NavMenuPanel links={links} />
</header>

<script>
	import { pathsEqual, url } from "@utils/url-utils";

	const menuButton = document.getElementById("nav-menu-switch");
	const menu = document.getElementById("nav-menu-panel");
	const setMenuOpen = (open: boolean) => {
		if (!menu) return;
		if (!open && menu.contains(document.activeElement)) menuButton?.focus();
		menu.inert = !open;
		menu.classList.toggle("float-panel-closed", !open);
		menuButton?.setAttribute("aria-expanded", String(open));
	};
	setMenuOpen(false);
	menuButton?.addEventListener("click", () => {
		setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
	});
	document.addEventListener("pointerdown", (event) => {
		if (event.target instanceof Node && !menu?.contains(event.target) && !menuButton?.contains(event.target)) setMenuOpen(false);
	});
	menu?.addEventListener("click", (event) => {
		if (event.target instanceof Element && event.target.closest("a")) setMenuOpen(false);
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") setMenuOpen(false);
	});
	const syncNavigation = () => {
		const section = document.querySelector<HTMLElement>("[data-post-section]")?.dataset.postSection;
		const path = section ? url(`/${section}/`) : location.pathname;
		for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-nav-path]")) {
			const target = link.dataset.navPath ?? "";
			const active = pathsEqual(path, target) || (!pathsEqual(target, url("/")) && path.startsWith(target));
			if (active) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		}
		setMenuOpen(false);
		document.getElementById("search-panel")?.classList.add("float-panel-closed");
	};
	syncNavigation();
	document.addEventListener("swup:page:view", syncNavigation);
</script>

{import.meta.env.PROD &&
<script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
    // is:inline — emitted verbatim, so this must stay plain JS
    async function loadPagefind() {
        try {
            const response = await fetch(scriptUrl, {method: 'HEAD'});
            if (!response.ok) {
                throw new Error(`Pagefind script not found: ${response.status}`);
            }

            const pagefind = await import(scriptUrl);

            await pagefind.options({
                excerptLength: 20
            });

            window.pagefind = pagefind;

            document.dispatchEvent(new CustomEvent('pagefindready'));
            console.log('Pagefind loaded and initialized successfully, event dispatched.');
        } catch (error) {
            console.error('Failed to load Pagefind:', error);
            window.pagefind = {
                search: () => Promise.resolve({results: []}),
                options: () => Promise.resolve(),
            };
            document.dispatchEvent(new CustomEvent('pagefindloaderror'));
            console.log('Pagefind load error, event dispatched.');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadPagefind);
    } else {
        loadPagefind();
    }
</script>}
