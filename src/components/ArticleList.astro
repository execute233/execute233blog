---
import type { CollectionEntry } from "astro:content";
import Pagination from "@components/control/Pagination.astro";
import PostPage from "@components/PostPage.astro";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { url } from "@utils/url-utils";
import type { Page } from "astro";

interface Props {
	page: Page<CollectionEntry<"posts">>;
	title: string;
	description: string;
}
const { page, title, description } = Astro.props;
---

<header class="rose-list-heading">
	<span class="eyebrow">THE INDEX / 运行实验簿</span>
	<h1>{title}</h1>
	<p>{description}</p>
	<a class="text-link" href={url("/archive/")}>{i18n(Key.archive)} <span aria-hidden="true">↗</span></a>
</header>
<PostPage page={page} />
{page.data.length === 0 && <p class="card-base p-8 text-75">还没有文章，新的记录正在路上。</p>}
<Pagination class="mx-auto" page={page} />
