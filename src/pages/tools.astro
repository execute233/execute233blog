---
import ToolCard from "@components/ToolCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { tools } from "@/data/tools";
---
<MainGridLayout title="工具">
    <header class="card-base p-9 mb-4"><h1 class="text-3xl text-90 font-bold mb-3">工具箱</h1>
        <p class="text-75">记录值得留下的工具与使用心得。以下为示例占位，后续持续更新。</p></header>
    <div class="grid xl:grid-cols-2 gap-4">{tools.map(tool =>
            <ToolCard tool={tool}/>)}</div>
</MainGridLayout>
