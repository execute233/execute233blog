---
import path from "node:path";
import ContentTabs from "@components/ContentTabs.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPostVariants, getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug, url } from "@utils/url-utils";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const variants = await getPostVariants(entry);
const rendered = await Promise.all(
	variants.map(async (variant) => ({
		entry: variant,
		...(await variant.render()),
	})),
);
const { Content } = rendered[0];
const headings = rendered.flatMap((variant) =>
	variant.headings.map((heading) => {
		const prefix = variant.entry.data.tabGroup
			? `${variant.entry.data.tabGroup.id}--`
			: "";
		return {
			...heading,
			slug: heading.slug.startsWith(prefix)
				? heading.slug
				: `${prefix}${heading.slug}`,
		};
	}),
);
const words = rendered.reduce(
	(total, variant) => total + (variant.remarkPluginFrontmatter.words ?? 0),
	0,
);
const minutes = rendered.reduce(
	(total, variant) => total + (variant.remarkPluginFrontmatter.minutes ?? 0),
	0,
);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	...(entry.data.updated
		? { dateModified: formatDateToYYYYMMDD(entry.data.updated) }
		: {}),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---

<MainGridLayout
	banner={entry.data.image}
	title={entry.data.title}
	description={entry.data.description}
	lang={entry.data.lang}
	setOGTypeArticle
	headings={headings}
>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	></script>
	<div data-post-section={entry.data.section}>
		<article
			id="post-container"
			class="rose-reading card-base"
			data-pagefind-meta={entry.data.tabGroup ? "tabbed:true" : undefined}
		>
			<header class="rose-reading-header">
				<a class="rose-reading-back" href={url(`/${entry.data.section}/`)}>← {i18n(I18nKey.backToList)}</a>
				<h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{entry.data.title}</h1>
				<PostMetadata
					class="mb-4"
					published={entry.data.published}
					updated={entry.data.updated}
					tags={entry.data.tags}
					category={entry.data.category}
				/>
				<div class="rose-reading-stats">
					<span>{words} {i18n(I18nKey.wordsCount)}</span>
					<span>{minutes} {i18n(minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
					<span>{profileConfig.name}</span>
				</div>
			</header>
			{entry.data.image && (
				<ImageWrapper
					id="post-cover"
					src={entry.data.image}
					basePath={path.join("content/posts/", getDir(entry.id))}
					class="mb-8 rounded-xl"
				/>
			)}
			{entry.data.tabGroup ? (
				<ContentTabs
					tabs={variants.map((variant) => ({
						id: variant.data.tabGroup!.id,
						label: variant.data.tabGroup!.label,
					}))}
				>
					{rendered.map(({ entry: variant, Content: TabContent }) => (
						<section
							id={`panel-${variant.data.tabGroup!.id}`}
							role="tabpanel"
							aria-labelledby={`tab-${variant.data.tabGroup!.id}`}
							tabindex="0"
							data-tab-panel={variant.data.tabGroup!.id}
						>
							<div class="mb-6 flex flex-wrap gap-x-5 gap-y-2 text-caption text-subtle" data-pagefind-ignore>
								<span>{variant.data.tabGroup!.label}</span>
								{variant.data.verified && (
									<span>
										{i18n(I18nKey.referenceVerified)}:
										<time datetime={formatDateToYYYYMMDD(variant.data.verified)}>
											{formatDateToYYYYMMDD(variant.data.verified)}
										</time>
									</span>
								)}
							</div>
							<Markdown class="mb-6 markdown-content"><TabContent /></Markdown>
						</section>
					))}
				</ContentTabs>
			) : <Markdown class="mb-6 markdown-content"><Content /></Markdown>}
			{licenseConfig.enable && (
				<License
					title={entry.data.title}
					slug={entry.slug}
					pubDate={entry.data.published}
					class="mb-6 rounded-xl"
				/>
			)}
		</article>
		<nav class="rose-reading-neighbors" aria-label={i18n(I18nKey.more)}>
			{entry.data.nextSlug && <a href={getPostUrlBySlug(entry.data.nextSlug)}>← {entry.data.nextTitle}</a>}
			{entry.data.prevSlug && <a href={getPostUrlBySlug(entry.data.prevSlug)}>{entry.data.prevTitle} →</a>}
		</nav>
	</div>
</MainGridLayout>
