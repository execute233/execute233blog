---
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import ProfileInterests from "@components/ProfileInterests.astro";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";
import "@/styles/rose-home.css";

const recent = (await getSortedPosts("blog")).slice(0, 3);
const learning = (await getSortedPosts("learning")).slice(0, 2);
const entries = [
	{ name: "博客", path: "/blog/", description: "软件开发与个人实践。" },
	{ name: "学习记录", path: "/learning/", description: "学习笔记与实践记录。" },
	{ name: "工具", path: "/tools/", description: "工具推荐与使用心得。" },
	{ name: "关于", path: "/about/", description: "我的介绍与兴趣。" },
];
---

<MainGridLayout
	description="来自广东的开发者，对 AI、软件开发和科学实验感兴趣。分享模型服务、AI Agent 和个人项目的实践记录。"
>
	<div data-landing class="rose-home">
		<header class="hero-heading">
			<span class="eyebrow">A PERSONAL STUDIO <span class="kicker-line"></span> 运行实验簿</span>
			<p class="hello">你好，世界。<span>I'm</span></p>
			<h1>execute<span>233</span><span class="title-period">.</span></h1>
			<p class="hero-description">对 AI、软件开发和科学实验感兴趣。</p>
		</header>
		<div class="rose-hero-grid">
			<section class="profile-card surface">
				<div class="profile-art">
					<div class="profile-orbit" aria-hidden="true"></div>
					<ImageWrapper
						src={profileConfig.avatar || ""}
						alt={`${profileConfig.name} 的头像`}
						class="rose-profile-image"
					/>
				</div>
				<span class="eyebrow">个人档案 / PROFILE</span>
				<h2>{profileConfig.name}<span class="status-dot" aria-hidden="true"></span></h2>
				<p>来自广东的开发者。<br />写代码，做实验，也探索 AI 应用。</p>
				<div class="social-links">
					{profileConfig.links.map((link) => (
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							<Icon name={link.icon} />{link.name}<span aria-hidden="true">↗</span>
						</a>
					))}
				</div>
				<div class="profile-bottom"><span class="mono">HELLO, WORLD_</span></div>
			</section>
			<section class="manifest-card surface">
				<div class="manifest-top">
					<span class="eyebrow"><span class="status-dot"></span> EXPLORING THE UNKNOWN</span>
					<span class="mono" aria-hidden="true">&lt; / &gt;</span>
				</div>
				<div class="manifest-orbit" aria-hidden="true"></div>
				<h2>你好，我是 Execute233，<br /><span>对 AI 和开发工具感兴趣的开发者。</span></h2>
				<p>最近在尝试模型服务和 AI Agent，也做过网站、机器人和一些小工具。<br />喜欢研究它们怎么工作，也希望做出自己用得上的东西。</p>
				<div class="manifest-bottom">
					<a href={url("/blog/")} class="pill-button">开始阅读 <span aria-hidden="true">↗</span></a>
					<a href={url("/learning/")} class="text-link">最近在学 <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</div>
		<nav class="entry-grid" aria-label="探索栏目">
			{entries.map((entry, index) => (
				<a href={url(entry.path)} class="entry-card surface">
					<span class="eyebrow">0{index + 1} / EXPLORE</span>
					<span class="entry-arrow" aria-hidden="true">↗</span>
					<h3>{entry.name}</h3><p>{entry.description}</p>
				</a>
			))}
		</nav>
		<section class="interest-section" aria-labelledby="home-interests-title">
			<header class="section-heading">
				<div>
					<span class="eyebrow">INTERESTS / EXPLORING</span>
					<h2 id="home-interests-title">我的兴趣</h2>
				</div>
				<a class="text-link" href={url("/about/")}>更多关于我 <span aria-hidden="true">↗</span></a>
			</header>
			<ProfileInterests />
		</section>
		{recent.length > 0 && (
			<section class="journal-section">
				<header class="section-heading">
					<div><span class="eyebrow">JOURNAL / RECENT</span><h2>{i18n(Key.recentPosts)}</h2></div>
					<a class="text-link" href={url("/blog/")}>{i18n(Key.more)} <span aria-hidden="true">↗</span></a>
				</header>
				<div class="post-rows">
					{recent.map((post, index) => (
						<a href={getPostUrlBySlug(post.slug)} class="post-row">
							<span class="row-index mono">0{index + 1}</span>
							<div>
								<span class="post-category">{post.data.category || i18n(Key.uncategorized)}</span>
								<h3>{post.data.title}</h3><p>{post.data.description}</p>
							</div>
							<time datetime={formatDateToYYYYMMDD(post.data.published)} class="mono">{formatDateToYYYYMMDD(post.data.published).replaceAll("-", ".")}</time>
							<span class="row-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>
		)}
		{learning.length > 0 && (
			<section class="learning-section">
				<header class="section-heading">
					<div><span class="eyebrow">LEARNING / IN PROGRESS</span><h2>最近的学习记录</h2></div>
					<a class="text-link" href={url("/learning/")}>学习记录 <span aria-hidden="true">↗</span></a>
				</header>
				<div class="learning-grid">
					{learning.map((post, index) => (
						<a href={getPostUrlBySlug(post.slug)} class="learning-card surface">
							<div class="note-heading"><span class="eyebrow">LEARNING NOTE / 0{index + 1}</span><span class="note-symbol" aria-hidden="true">{index === 0 ? "✳︎" : "↺"}</span></div>
							<h3>{post.data.title}</h3><p>{post.data.description}</p>
							<div class="note-footer"><time datetime={formatDateToYYYYMMDD(post.data.published)} class="mono">{formatDateToYYYYMMDD(post.data.published).replaceAll("-", ".")}</time><span>{i18n(Key.more)} ↗</span></div>
						</a>
					))}
				</div>
			</section>
		)}
	</div>
</MainGridLayout>
